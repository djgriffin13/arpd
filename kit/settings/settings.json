{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/log_hook.py"], "timeout": 10 }] }]
  }
}
